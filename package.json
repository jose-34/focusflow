{
  "name": "focusflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "npm run db:migrate:deploy && tsx server/prod.ts",
    "db:migrate:deploy": "drizzle-kit push && tsx app/db/apply-rls.ts",
    "db:bootstrap-role": "tsx --env-file=.env app/db/bootstrap-role.ts",
    "db:push": "drizzle-kit push",
    "db:rls": "tsx --env-file=.env app/db/apply-rls.ts",
    "db:seed-curricula": "tsx --env-file=.env app/db/seed-curricula.ts",
    "db:seed-shop-items": "tsx --env-file=.env app/db/seed-shop-items.ts",
    "db:seed-admin": "tsx --env-file=.env app/db/seed-admin.ts",
    "db:backfill-quiz-authors": "tsx --env-file=.env app/db/backfill-quiz-authors.ts",
    "db:seed-pilot-demo": "tsx --env-file=.env app/db/seed-pilot-demo.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@google/genai": "^2.15.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "^1.3.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.32",
    "@whatwg-node/server": "^0.11.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
